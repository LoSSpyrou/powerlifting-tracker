# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
# (Ignored here because settings.json contains a machine-specific absolute path.)
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code local artifacts (team-shared config -- agents/, commands/,
# hooks/, rules/, settings.json -- is tracked; only personal/machine-local
# files are ignored)
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/settings.json.graphify-bak

# graphify machine-local state (absolute paths + regenerable cache; the
# graph outputs themselves -- graph.json, GRAPH_REPORT.md, graph.html,
# manifest.json -- are tracked)
/graphify-out/.graphify_python
/graphify-out/.graphify_root
/graphify-out/cache/
